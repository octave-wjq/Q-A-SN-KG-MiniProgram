.notification-page {
  padding-bottom: 48rpx;
}

.intro-card {
  background: linear-gradient(135deg, #2DC97E, #3FD9A0);
  box-shadow: 0 14rpx 32rpx rgba(45, 201, 126, 0.28);
}

.intro-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.intro-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
}

.filter-row {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
}

.filter-chip {
  flex: 1;
  padding: 14rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 25rpx;
  color: #667B95;
  background: #F5F6F8;
  border: 1rpx solid #E3E8EF;
}

.filter-chip.active {
  color: var(--color-primary-dark);
  border-color: #8FE3B8;
  background: var(--color-primary-soft);
  font-weight: 600;
}

.notice-card {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.notice-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 40rpx;
  background: var(--color-primary-soft);
}

.notice-icon.appt {
  background: #E9F2FF;
}

.notice-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.notice-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #52657F;
}

.days-badge {
  align-self: flex-start;
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #9A6700;
  background: #FFF7E6;
}

.notice-btn {
  flex-shrink: 0;
  min-width: 132rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: none;
  font-size: 24rpx;
  color: #FFFFFF;
  background: var(--color-primary);
}

.notice-btn::after {
  border: none;
}

.empty-box {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.empty-icon {
  font-size: 72rpx;
  opacity: 0.55;
}

.empty-text {
  font-size: 26rpx;
  color: var(--color-subtext);
}
