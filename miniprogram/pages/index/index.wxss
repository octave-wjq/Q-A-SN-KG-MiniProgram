.index-page {
  padding-bottom: 36rpx;
}

.welcome-card {
  background: linear-gradient(135deg, #2DC97E, #3FD9A0);
  color: #FFFFFF;
  box-shadow: 0 14rpx 32rpx rgba(45, 201, 126, 0.28);
}

.welcome-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.2);
}

.welcome-content {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.welcome-greeting {
  font-size: 36rpx;
  font-weight: 600;
}

.welcome-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  opacity: 0.95;
}

.section-block {
  margin-top: 24rpx;
}

/* 卡片标题左侧绿色竖条装饰 */
.section-title {
  position: relative;
  padding-left: 22rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.shortcut-grid {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  margin-left: -18rpx;
}

.shortcut-item {
  width: calc(50% - 18rpx);
  margin-left: 18rpx;
  margin-top: 18rpx;
  min-height: 196rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.shortcut-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  font-size: 42rpx;
  background: var(--color-primary-soft);
}

.shortcut-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.shortcut-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-subtext);
}

.tips-card {
  margin-top: 24rpx;
}

.tip-item {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-start;
}

.tip-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
}

.tip-text {
  margin-left: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #4F5B70;
}

.symptom-card {
  margin-top: 24rpx;
}

.symptom-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-subtext);
}

.cluster-block {
  margin-top: 22rpx;
}

.cluster-title {
  display: block;
  font-size: 24rpx;
  color: #4F5B70;
  font-weight: 600;
}

.symptom-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.symptom-tag {
  display: flex;
  align-items: center;
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E3E8EF;
  background: #F7F8FA;
}

.symptom-tag.active {
  border-color: #8FE3B8;
  background: var(--color-primary-soft);
}

.symptom-checkbox {
  transform: scale(0.72);
  transform-origin: left center;
  margin-right: 4rpx;
}

.symptom-name {
  font-size: 22rpx;
  color: #32506F;
  line-height: 1.3;
  word-break: break-all;
}

.symptom-tag.active .symptom-name {
  color: var(--color-primary-dark);
}

.severity-card {
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
  padding: 14rpx 16rpx;
}

.severity-title {
  display: block;
  font-size: 24rpx;
  color: #4F5B70;
  font-weight: 600;
}

.severity-item {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.severity-name {
  font-size: 24rpx;
  color: #30465F;
  font-weight: 500;
}

.severity-seg {
  display: flex;
  gap: 10rpx;
}

.sev-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #6B7A90;
  background: #F2F4F7;
  border: 1rpx solid #E2E6EB;
  transition: all 0.15s;
}

/* 选中态按等级配色：轻微绿 → 中等黄 → 较重橙 → 严重红 */
.sev-btn.sev-1.active {
  color: #FFFFFF;
  background: #52C41A;
  border-color: #52C41A;
}

.sev-btn.sev-2.active {
  color: #FFFFFF;
  background: #FAAD14;
  border-color: #FAAD14;
}

.sev-btn.sev-3.active {
  color: #FFFFFF;
  background: #FA8C16;
  border-color: #FA8C16;
}

.sev-btn.sev-4.active {
  color: #FFFFFF;
  background: #F5222D;
  border-color: #F5222D;
}

.symptom-submit {
  margin-top: 22rpx;
}

.symptom-submit.disabled {
  opacity: 0.6;
}

.result-wrap {
  margin-top: 24rpx;
}

.result-card {
  margin-top: 16rpx;
}

.result-card:first-child {
  margin-top: 0;
}

.result-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.empty-text {
  margin-top: 14rpx;
  display: block;
  font-size: 24rpx;
  color: var(--color-subtext);
}

.warning-item {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #F7F8FA;
}

.warning-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.warning-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 600;
}

.warning-score {
  font-size: 22rpx;
  color: #5F7289;
}

.warning-link {
  margin-top: 8rpx;
  display: block;
  font-size: 22rpx;
  color: var(--color-subtext);
  line-height: 1.45;
}

.advice-item {
  margin-top: 16rpx;
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
  border-left: 10rpx solid transparent;
}

.advice-urgent {
  border-left-color: #F5222D;
  background: #FFF1F0;
}

.advice-followup {
  border-left-color: #FA8C16;
  background: #FFF7E6;
}

.advice-daily {
  border-left-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.advice-head {
  display: flex;
  align-items: center;
}

.advice-tag {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(31, 45, 61, 0.7);
}

.advice-text {
  margin-top: 10rpx;
  display: block;
  font-size: 24rpx;
  line-height: 1.65;
  color: #30465F;
  white-space: pre-wrap;
  word-break: break-all;
}

.advice-raw {
  margin-top: 14rpx;
  display: block;
  font-size: 24rpx;
  line-height: 1.65;
  color: #30465F;
  white-space: pre-wrap;
  word-break: break-all;
}

.ask-qa-btn {
  margin-top: 22rpx;
}

.emergency-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #FFF1F0;
  border: 2rpx solid #FFCCC7;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
}

.emergency-left {
  display: flex;
  align-items: center;
}

.emergency-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.emergency-texts {
  display: flex;
  flex-direction: column;
}

.emergency-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #CF1322;
}

.emergency-sub {
  font-size: 24rpx;
  color: #FF7875;
  margin-top: 4rpx;
}

.emergency-call-btn {
  background: #FF4D4F;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  flex-shrink: 0;
}

.emergency-call-btn::after {
  border: none;
}

/* AI 生成提示 */
.ai-gen-tip {
  display: block;
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  background: #FFF7E6;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: #B45309;
  line-height: 1.5;
}
