<view class="container index-page">
  <view class="card welcome-card">
    <view class="welcome-row">
      <image class="avatar" src="{{userAvatar}}" mode="aspectFill" />
      <view class="welcome-content">
        <text class="welcome-greeting">{{greeting}}</text>
        <text class="welcome-desc">欢迎使用艾滋病健康管理助手</text>
      </view>
    </view>
  </view>

  <view class="section-block">
    <text class="section-title">快捷入口</text>
    <view class="shortcut-grid">
      <view class="card shortcut-item" wx:for="{{shortcuts}}" wx:key="title" data-index="{{index}}" bindtap="handleShortcutTap">
        <text class="shortcut-icon">{{item.icon}}</text>
        <text class="shortcut-title">{{item.title}}</text>
        <text class="shortcut-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="card symptom-card">
    <text class="section-title">今日症状自查</text>
    <text class="symptom-desc">勾选当前症状并标记严重程度，系统将给出伴随症状预警与管理建议。</text>

    <checkbox-group bindchange="onSymptomCheckChange">
      <view class="cluster-block" wx:for="{{symptomGroups}}" wx:key="key">
        <text class="cluster-title">{{item.title}}</text>
        <view class="symptom-tags">
          <label class="symptom-tag {{selectedSet[subItem.name] ? 'active' : ''}}" wx:for="{{item.symptoms}}" wx:key="name" wx:for-item="subItem">
            <checkbox class="symptom-checkbox" value="{{subItem.name}}" checked="{{selectedSet[subItem.name]}}" color="#2DC97E" />
            <text class="symptom-name">{{subItem.name}}</text>
          </label>
        </view>
      </view>
    </checkbox-group>

    <view class="severity-card" wx:if="{{selectedSymptoms.length}}">
      <text class="severity-title">标记严重程度</text>
      <view class="severity-item" wx:for="{{selectedSymptoms}}" wx:key="*this" wx:for-item="symptomName">
        <text class="severity-name">{{symptomName}}</text>
        <view class="severity-seg">
          <view wx:for="{{severityOptions}}" wx:key="value" wx:for-item="opt"
                class="sev-btn {{opt.cls}} {{severityMap[symptomName] === opt.value ? 'active' : ''}}"
                data-name="{{symptomName}}" data-value="{{opt.value}}" bindtap="onSeverityTap">
            {{opt.label}}
          </view>
        </view>
      </view>
    </view>

    <button class="btn-primary symptom-submit {{isSubmitting ? 'disabled' : ''}}" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="onSubmitSymptomCheck">
      获取管理建议
    </button>
  </view>

  <view class="result-wrap" wx:if="{{resultVisible}}">
    <view class="card result-card">
      <text class="result-title">可能伴随症状</text>
      <text class="empty-text" wx:if="{{!predictedSymptoms.length}}">当前未识别到明显伴随症状预警。</text>
      <view class="warning-item" wx:for="{{predictedSymptoms}}" wx:key="name">
        <view class="warning-head">
          <text class="warning-name">{{item.name}}</text>
          <text class="warning-score">关联权重 {{item.scoreText}}</text>
        </view>
        <text class="warning-link">关联来源：{{item.linkedFromText}}</text>
      </view>
    </view>

    <view class="card result-card">
      <text class="result-title">管理建议</text>
      <text class="ai-gen-tip">⚠️ 以下建议由 AI 人工智能生成，仅供参考，不能替代专业医生诊断</text>
      <view class="emergency-banner" wx:if="{{hasUrgent}}">
        <view class="emergency-left">
          <text class="emergency-icon">⚠️</text>
          <view class="emergency-texts">
            <text class="emergency-title">紧急就医提醒</text>
            <text class="emergency-sub">你的部分症状可能需要尽快就医</text>
          </view>
        </view>
        <button class="emergency-call-btn" bindtap="onCallEmergency">拨打120</button>
      </view>
      <view class="advice-item {{item.className}}" wx:for="{{adviceSections}}" wx:key="level">
        <view class="advice-head">
          <text class="advice-tag">{{item.level}}</text>
        </view>
        <text class="advice-text">{{item.text}}</text>
      </view>
      <text class="advice-raw" wx:if="{{adviceText && !adviceSections.length}}">{{adviceText}}</text>
      <button class="btn-secondary ask-qa-btn" bindtap="onAskInQa">去问答继续咨询</button>
    </view>
  </view>

  <view class="card tips-card">
    <text class="section-title">健康小贴士</text>
    <view class="tip-item" wx:for="{{tips}}" wx:key="index">
      <text class="tip-dot"></text>
      <text class="tip-text">{{item}}</text>
    </view>
  </view>
</view>
