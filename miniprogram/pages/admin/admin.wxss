.admin-page { padding: 24rpx; }
.header-card { background: linear-gradient(135deg, #1890FF, #36CFC9); border-radius: 16rpx; padding: 40rpx 32rpx; margin-bottom: 32rpx; }
.header-title { font-size: 36rpx; font-weight: 600; color: #fff; display: block; }
.header-desc { font-size: 24rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx; display: block; }
.section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #333; display: block; margin-bottom: 16rpx; }
.import-item { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.import-item:last-child { border-bottom: none; }
.item-info { flex: 1; }
.item-label { font-size: 26rpx; color: #333; display: block; }
.item-status { font-size: 22rpx; margin-top: 4rpx; display: block; color: #999; }
.item-status.success { color: #52c41a; }
.item-status.error { color: #ff4d4f; }
.import-btn { font-size: 24rpx; background: #1890FF; color: #fff; border-radius: 8rpx; }
.import-btn[disabled] { background: #d9d9d9; color: #999; }
.batch-btn { width: 100%; background: #52c41a; color: #fff; font-size: 28rpx; border-radius: 12rpx; padding: 20rpx 0; }
.batch-btn[disabled] { background: #d9d9d9; color: #999; }
.log-section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; max-height: 400rpx; overflow-y: auto; }
.log-item { padding: 6rpx 0; }
.log-text { font-size: 22rpx; color: #666; display: block; }
.log-text.success { color: #52c41a; }
.log-text.error { color: #ff4d4f; }
